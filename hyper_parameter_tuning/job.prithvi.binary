#!/usr/local/bin/bash
#SBATCH --job-name=prithvi-ag   #job name
#SBATCH -o irrigation_prithvi_gpu.o%j
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:4
#SBATCH --mem-per-gpu=50G
#SBATCH --time=1:59:00
#SBATCH --account=s1189
#SBATCH --constraint=rome
##SBATCH --qos=debug
ulimit -s unlimited

## load the necessary modules and activate the prithvi env
module load anaconda
conda activate prithvi

srun --gres=gpu:4 --exclusive python3 prithvi_irrigated_rainfed_classification.py
