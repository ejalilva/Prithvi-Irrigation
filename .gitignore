# ============================
# General Python Ignore Rules
# ============================
__pycache__/
*.py[cod]
*$py.class

# ============================
# Virtual Environment & Dependencies
# ============================
env/
venv/
.venv/
*.egg-info/
*.egg
*.whl

# ============================
# Jupyter Notebooks & Checkpoints
# ============================
.ipynb_checkpoints/

# ============================
# PyTorch-Specific Ignore Rules
# ============================
*.pt          # PyTorch model files
*.pth         # PyTorch model checkpoints
*.onnx        # ONNX exported models
torch_cache/  # Torch caching folder

# ============================
# Lightning-Specific Ignore Rules
# ============================
lightning_logs/      # Lightning training logs
lightning_checkpoints/  # Lightning-generated model checkpoints
checkpoints/         # Model checkpoints
*.ckpt               # Checkpoint files
*.h5                 # HDF5 model files (sometimes used for saving weights)
tensorboard/         # TensorBoard logs

# ============================
# Logging, Debugging & Outputs
# ============================
logs/
*.log
*.out
*.err

# ============================
# Large Data Files & Outputs
# ============================
*.csv
*.h5
*.sqlite
*.db
*.pickle
*.npy
*.npz
*.parquet

# ============================
# Environment Files
# ============================
.env
*.env

# ============================
# System Files
# ============================
.DS_Store
Thumbs.db

# ============================
# Slurm & HPC Specific Ignore Rules
# ============================
slurm-*.out  # SLURM output logs
*.sbatch      # SLURM batch script files

