#!/bin/bash
#SBATCH --job-name=xgb_cpu
#SBATCH --output=xgb_cpu.o%j
#SBATCH --error=xgb_cpu.e%j
#SBATCH --time=21:00:00
#SBATCH --time-min=4:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=120
#SBATCH --cpus-per-task=1
#SBATCH --mem=480G
#SBATCH --account=s1189
#SBATCH --constraint=mil
#SBATCH --qos=long
#SBATCH --no-requeue

# Set stack size limit
ulimit -s unlimited

# Error handling function
error_exit() {
    echo "Error: $1" >&2
    exit 1
}

# Load modules with error checking
ml load anaconda || error_exit "Failed to load anaconda module"

# Activate conda environment with error checking
conda activate terratorch-tune

# Print job information
echo "Job started at: $(date)"
echo "Running on node: $(hostname)"
echo "Job ID: $SLURM_JOB_ID"
echo "Number of tasks: $SLURM_NTASKS"
echo "CPUs per task: $SLURM_CPUS_PER_TASK"

# Run the Python script with error checking
python3 ./xgb_train_bench_cpu.py || error_exit "Python script failed"

echo "Job completed at: $(date)"